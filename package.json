{
  "name": "coldz-launcher",
  "private": true,
  "version": "0.2.1",
  "description": "COLDZ launcher: starts FiveM and connects to the COLDZ server",
  "scripts": {
    "dev": "tauri dev",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Release",
    "set-version": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-version.ps1",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "tauri icon branding/icon-source.png",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
